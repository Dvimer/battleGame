; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shardfall Arena"
run/main_scene="res://scenes/battle/battle.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/world/event_bus.gd"
WorldGenerator="*res://scripts/world/world_generator.gd"
ChunkCache="*res://scripts/world/chunk_cache.gd"
ChunkManager="*res://scripts/world/chunk_manager.gd"
FogOfWar="*res://scripts/world/fog_of_war.gd"
QuestManager="*res://scripts/world/quest_manager.gd"
GameState="*res://scripts/world/game_state.gd"
Localizer="*res://scripts/localizer.gd"
MenuManager="*res://scripts/menu_manager.gd"
SceneRouter="*res://scripts/scene_router.gd"
WorldState="*res://scripts/world_state.gd"
BattleContext="*res://scripts/battle/battle_context.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

